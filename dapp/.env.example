# Activity and contract
# Local Anvil is the default. Use 84532 for Base Sepolia or 8453 for Base Mainnet.
NEXT_PUBLIC_CHAIN_ID=31337
# Set this to the ActivityPhotoRegistry deployment address on the selected chain.
NEXT_PUBLIC_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
# Set this to the block containing the deployment transaction.
NEXT_PUBLIC_DEPLOY_BLOCK=0
# Keep event queries within the RPC provider's eth_getLogs range limit.
NEXT_PUBLIC_LOG_BLOCK_RANGE=9000

# Wallet connection
# Used only when NEXT_PUBLIC_CHAIN_ID=31337.
NEXT_PUBLIC_LOCAL_RPC_URL=http://127.0.0.1:8545
# Optional. Injected wallets and Coinbase Wallet still work when this is empty.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Encrypted photo storage
# Local development uses the local-arweave adapter and ArLocal gateway.
# The test environment has multiple implementations depending on the provider, requiring code modifications. For example, services such as Irys, Turbo, and ArDrive each have their own testing APIs, SDKs, quotas, and data retention policies. Therefore, this part is handled using a locally built AR service.
ARWEAVE_UPLOAD_ENDPOINT=http://127.0.0.1:1985/upload
ARWEAVE_UPLOAD_TOKEN=
ARWEAVE_GATEWAY_URL=http://127.0.0.1:1984
# For local disk storage without local-arweave, leave ARWEAVE_UPLOAD_ENDPOINT empty.
# For production, replace these values with the production adapter and gateway, for example:
# ARWEAVE_UPLOAD_ENDPOINT=https://uploader.example.com/upload
# ARWEAVE_UPLOAD_TOKEN=server-side-token
# ARWEAVE_GATEWAY_URL=https://arweave.net

# Time capsule: Drand Quicknet
# These public protocol values must match src/ActivityPhotoRegistry.sol.
NEXT_PUBLIC_DRAND_QUICKNET_CHAIN_HASH=0x52db9ba70e0cc0f6eaf7803dd07447a1f5477735fd3f661792ba94600c84e971
NEXT_PUBLIC_DRAND_QUICKNET_PUBLIC_KEY=0x83cf0f2896adee7eb8b5f01fcad3912212c437e0073e911fb90022d3e760183c8c4b450b6a0a6c3ac6a5776a2d1064510d1fec758c921cc22b0e17e63aaf4bcb5ed66304de9cf809bd274ca73bab4af5a6e9c76a4bc09e76eae8991ef5ece45a
NEXT_PUBLIC_DRAND_QUICKNET_SCHEME_ID=bls-unchained-g1-rfc9380
NEXT_PUBLIC_DRAND_QUICKNET_PERIOD_SECONDS=3
NEXT_PUBLIC_DRAND_QUICKNET_GENESIS_TIME=1692803367
# The app tries the primary gateway first, then the fallback gateway.
NEXT_PUBLIC_DRAND_QUICKNET_PRIMARY_URL=https://api.drand.sh/52db9ba70e0cc0f6eaf7803dd07447a1f5477735fd3f661792ba94600c84e971
NEXT_PUBLIC_DRAND_QUICKNET_FALLBACK_URL=https://drand.cloudflare.com/52db9ba70e0cc0f6eaf7803dd07447a1f5477735fd3f661792ba94600c84e971
