# Base Sepolia by default. Use 8453 for Base Mainnet, 31337 for local Anvil.
NEXT_PUBLIC_CHAIN_ID=84532
NEXT_PUBLIC_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_DEPLOY_BLOCK=0
# Keep this within the RPC provider's eth_getLogs range limit.
NEXT_PUBLIC_LOG_BLOCK_RANGE=9000
# Used only when NEXT_PUBLIC_CHAIN_ID=31337.
NEXT_PUBLIC_LOCAL_RPC_URL=http://127.0.0.1:8545

# Optional WalletConnect project ID. Injected and Coinbase connectors still work without it.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Optional production storage adapter. Without these values, the DApp uses local encrypted storage.
ARWEAVE_UPLOAD_ENDPOINT=
ARWEAVE_UPLOAD_TOKEN=
ARWEAVE_GATEWAY_URL=https://arweave.net
